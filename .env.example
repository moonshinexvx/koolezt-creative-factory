NODE_ENV=development
APP_PORT=3000
DATABASE_URL=
REDIS_URL=
WORKING_MEDIA_ROOT=
READY_ROOT=
# Production durable media. Keep local for development; use s3 only after the live storage smoke passes.
DURABLE_MEDIA_PROVIDER=local
DURABLE_MEDIA_URL_TTL_SECONDS=900
MEDIA_REJECTED_RETENTION_DAYS=7
MEDIA_READY_GRACE_DAYS=7
MEDIA_ABANDONED_UPLOAD_HOURS=24
PRODUCT_REFERENCE_MAX_BYTES=20971520
MEDIA_CLEANUP_INTERVAL_MS=3600000
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=info
# Production browser access. Cloudflare Access JWTs are cryptographically verified by the API.
BROWSER_AUTH_PROVIDER=
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
CREATIVE_OWNER_EMAILS=
CREATIVE_EDITOR_EMAILS=
CREATIVE_BROWSER_ORIGINS=https://creative.printwlove.com,http://127.0.0.1:3100,http://localhost:3100
CREATIVE_BROWSER_HOST=creative.printwlove.com
RENDER_WORKER_HOST=worker.printwlove.com
FFPROBE_PATH=
FAKE_MP4_FIXTURE=tests/fixtures/vertical-1080x1920.mp4

CREATIVE_PROVIDER=fake
VIDEO_PROVIDER=fake
# Optional per-runtime fallback; a scene's saved provider selection wins.
DEFAULT_VIDEO_PROVIDER=
VOICE_PROVIDER=fake
COMPOSITION_PROVIDER=fake
# Dedicated, independently revocable credential for render-worker/v1 endpoints.
RENDER_WORKER_TOKEN=
RENDER_WORKER_LEASE_MS=300000
RENDER_WORKER_MAX_OUTPUT_BYTES=524288000
RENDER_WORKER_INSTALLER_PATH=dist/KooleztCreativeFactoryRenderWorker-Setup.exe
EXTERNAL_MEDIA_DELIVERY_PROVIDER=disabled
S3_ENDPOINT=
# For standard AWS S3, set the actual bucket region (for example us-east-1).
# Leave S3_ENDPOINT empty to use AWS's regional endpoint resolution.
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
EXTERNAL_MEDIA_URL_TTL_SECONDS=3600
ALLOW_PAID_PROVIDER_TESTS=false
KOOLEZT_ALLOW_PAID_PROVIDER_TESTS=false

# CREATIVE_PROVIDER=claude enables Claude for Strategy, Creative Concepts, Creative DNA, variant copy, and narration rewrites.
# Keep CREATIVE_PROVIDER=fake for development. A paid smoke test (pnpm test:claude-smoke) additionally requires KOOLEZT_ALLOW_PAID_PROVIDER_TESTS=true.
ANTHROPIC_API_KEY=
CLAUDE_CREATIVE_MODEL=claude-opus-5-5
# Worker jobs (Strategy, background Concepts, Creative DNA) run one direct call each; default medium.
CLAUDE_BACKGROUND_EFFORT=medium
# Browser-request actions (concept, variant copy, narration rewrite) must finish inside the ~100s proxy limit; default low.
CLAUDE_INTERACTIVE_EFFORT=low

# Creative DNA: frames sampled per winning ad (hook, each detected scene cut, ending); 12-60.
CREATIVE_DNA_MAX_FRAMES=30
# Automatic voiceover transcription for Creative DNA. disabled or openai (uses OPENAI_API_KEY; whisper-1 returns segment timestamps).
DNA_TRANSCRIPTION_PROVIDER=disabled
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Meta Ads (read-only) for Winner Analysis imports. Use a dedicated system-user token with ads_read,
# pages_read_engagement and pages_show_list; never reuse a token that can manage ads.
META_ADS_ACCESS_TOKEN=
# Comma-separated ad account IDs, e.g. act_1234567890,act_2345678901
META_AD_ACCOUNT_IDS=
META_GRAPH_API_VERSION=v24.0
# Lifetime results of imported winners are refreshed by the worker on this interval (default daily).
META_REFRESH_INTERVAL_MS=86400000

# OpenAI remains for TTS (VOICE_PROVIDER=openai), DNA transcription, and as a creative rollback (CREATIVE_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_CREATIVE_MODEL=
# HTTP transport timeout for Strategy submit/retrieve only. Background model execution is not limited by this value.
OPENAI_STRATEGY_HTTP_TIMEOUT_MS=30000
# Bounds only Creative Concept submit/retrieve HTTP transport; background model execution is not limited to this duration.
OPENAI_CONCEPT_HTTP_TIMEOUT_MS=30000
# Keep CREATIVE_PROVIDER=fake unless deliberately enabling server-side OpenAI concepts.
# A paid smoke test additionally requires KOOLEZT_ALLOW_PAID_PROVIDER_TESTS=true.
# AI scene images (Make AI scene images button) use OPENAI_API_KEY. Quality: low, medium or high (higher costs more per image).
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_VOICE_MODEL=gpt-4o-mini-tts
OPENAI_VOICE_NAME=marin
OPENAI_VOICE_OUTPUT_FORMAT=mp3
# Optional delivery instruction for gpt-4o-mini-tts; do not put customer data here.
OPENAI_VOICE_INSTRUCTIONS=Warm, natural and engaging social-media ad voice. Friendly and conversational, with confident pacing. Avoid exaggerated announcer delivery.
# Keep VOICE_PROVIDER=fake unless deliberately enabling server-side OpenAI TTS.
KLING_API_KEY=
KLING_API_BASE_URL=https://api-singapore.klingai.com
KLING_VIDEO_MODEL=kling-3.0-turbo
KLING_VIDEO_RESOLUTION=720p
KLING_ASPECT_RATIO=9:16
KLING_MAX_OUTPUT_BYTES=157286400
KLING_DOWNLOAD_TIMEOUT_MS=60000
KLING_MAX_CONCURRENCY=1
KLING_OUTPUT_HOST_SUFFIXES=klingai.com
# Keep VIDEO_PROVIDER=fake unless deliberately enabling server-side Kling generation.
# Image-to-video also requires EXTERNAL_MEDIA_DELIVERY_PROVIDER=s3.
# A paid smoke test additionally requires KOOLEZT_ALLOW_PAID_PROVIDER_TESTS=true.
SEEDANCE_API_KEY=
SEEDANCE_VIDEO_MODEL=dreamina-seedance-2-5-260628
SEEDANCE_API_BASE_URL=https://operator.las.ap-southeast-1.bytepluses.com
SEEDANCE_VIDEO_RESOLUTION=720p
SEEDANCE_MAX_CONCURRENCY=1
SEEDANCE_MAX_OUTPUT_BYTES=157286400
SEEDANCE_DOWNLOAD_TIMEOUT_MS=60000
SEEDANCE_OUTPUT_HOST_SUFFIXES=volces.com,bytepluses.com
# Seedance image/reference inputs require EXTERNAL_MEDIA_DELIVERY_PROVIDER=s3.
# Keep VIDEO_PROVIDER=fake until Seedance is deliberately selected for a scene.
# A paid smoke test must additionally require KOOLEZT_ALLOW_PAID_PROVIDER_TESTS=true.
# Optional shared conservative cap for mixed per-scene providers.
VIDEO_WORKER_CONCURRENCY=1
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=
ELEVENLABS_OUTPUT_FORMAT=
# JSON map keyed by internal voice profile ID, e.g. {"female-ugc":{"providerVoiceId":"...","settings":{"stability":0.5}}}
ELEVENLABS_VOICE_PROFILES_JSON={}
CREATOMATE_API_KEY=
# Direct RenderScript is used for koolezt-ugc-fast/v1; no mutable template ID is required.
CREATOMATE_MAX_OUTPUT_BYTES=262144000
# Explicit paid smoke test only; this must be a temporary trusted staging URL, never a local path.
CREATOMATE_SMOKE_MEDIA_URL=
