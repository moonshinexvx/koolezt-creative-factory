{
  "name": "koolezt-creative-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "dev:api": "tsx apps/api/src/server.ts",
    "dev:worker": "tsx apps/worker/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "start:api": "tsx apps/api/src/server.ts",
    "start:worker": "tsx apps/worker/src/index.ts",
    "start:render-worker": "tsx apps/render-worker/src/index.ts",
    "build:render-worker": "tsx scripts/build-render-worker.ts",
    "test:render-worker-sea": "tsx scripts/test-render-worker-sea.ts",
    "test:render-worker-fixture": "tsx scripts/render-worker-fixture.ts",
    "test:variant-motion-fixture": "tsx scripts/variant-motion-fixture.ts",
    "smoke:production": "tsx scripts/production-smoke.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:dry-run": "tsx scripts/migration-dry-run.ts",
    "media:reset": "tsx scripts/reset-media.ts",
    "test:claude-smoke": "tsx scripts/claude-smoke.ts",
    "test:openai-smoke": "tsx scripts/openai-smoke.ts",
    "test:openai-voice-smoke": "tsx scripts/openai-voice-smoke.ts",
    "test:elevenlabs-smoke": "tsx scripts/elevenlabs-smoke.ts",
    "test:creatomate-smoke": "tsx scripts/creatomate-smoke.ts",
    "test:kling-smoke": "tsx scripts/kling-smoke.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:s3-durable-smoke": "tsx scripts/s3-durable-media-smoke.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^8.2.2",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "archiver": "^8.0.0",
    "bullmq": "^6.3.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  }
}
