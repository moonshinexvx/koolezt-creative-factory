{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@koolezt/domain": ["packages/domain/src/index.ts"],
      "@koolezt/application": ["packages/application/src/index.ts"],
      "@koolezt/providers": ["packages/providers/src/index.ts"],
      "@koolezt/infrastructure": ["packages/infrastructure/src/index.ts"],
      "@koolezt/media": ["packages/media/src/index.ts"]
      ,"@koolezt/contracts": ["packages/contracts/src/index.ts"]
    }
  }
}
